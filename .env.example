# Copia este fichero como .env y rellena los valores (nunca subas .env a Git).
# En Render, las mismas variables van en el panel del servicio.
# Los comentarios van en su propia línea: docker run --env-file no admite comentarios al final.

# --- LLM (Gemini) ---
GOOGLE_API_KEY=tu_clave_de_google_ai_studio
LLM_MODEL=gemini-3.1-flash-lite

# --- API ---
# Sin API_KEY, las rutas protegidas devuelven 503.
API_KEY=una_clave_larga_para_la_api
# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:8501
# Si un turno tarda más, 504. Bájalo en local para probarlo.
ASK_TIMEOUT_SECONDS=300
# Peticiones por minuto; por encima, 429.
RATE_LIMIT_PER_MINUTE=30

# --- PostgreSQL ---
# Local con Docker: postgresql://postgres:postgres@localhost:5432/deporte
# Render da postgres://...; config.py lo normaliza.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deporte

# --- Desarrollo ---
# 1: tools falsas, sin RAG, sin red y sin Gemini en las tools.
USE_MOCKS=0

# --- Front (front/streamlit_app.py, solo habla HTTP) ---
# En la demo final, la URL de Render.
API_BASE_URL=http://127.0.0.1:8000
